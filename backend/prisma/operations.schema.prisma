// MERGE THESE MODELS INTO YOUR EXISTING schema.prisma.
// If Vehicle, Driver or Trip already exist, keep your existing models and only add
// the missing models/fields needed by the relations.

model Trip {
  id          String   @id @default(cuid())
  reference   String   @unique
  origin      String
  destination String
  departureAt DateTime
  arrivalAt   DateTime?
  status      String   @default("PLANNED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicleAllocations VehicleAllocation[]
  driverAllocations  DriverAllocation[]
  manifests          Manifest[]
  monitoringEvents   MonitoringEvent[]
}

model VehicleAllocation {
  id        String   @id @default(cuid())
  tripId    String
  vehicleId String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([vehicleId])
}

model DriverAllocation {
  id        String   @id @default(cuid())
  tripId    String
  driverId  String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([driverId])
}

model Manifest {
  id               String   @id @default(cuid())
  tripId           String
  reference        String
  cargoDescription  String
  quantity         Int      @default(0)
  weightKg         Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  @@index([tripId])
  @@unique([tripId, reference])
}

model MonitoringEvent {
  id          String   @id @default(cuid())
  tripId      String
  eventType   String
  latitude    Float?
  longitude   Float?
  speedKph    Float?
  odometerKm Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  @@index([tripId, createdAt])
}

// If your existing Vehicle/Driver models use different names or IDs,
// adjust the two relation declarations above to match them.
